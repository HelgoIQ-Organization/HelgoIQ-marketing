{
  "name": "helgoiq-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy:preview": "pnpm build && npx --yes wrangler pages deploy dist --project-name=$CLOUDFLARE_PAGES_PROJECT --branch=preview --commit-dirty=true",
    "deploy:production": "pnpm build && npx --yes wrangler pages deploy dist --project-name=$CLOUDFLARE_PAGES_PROJECT --branch=main --commit-dirty=true",
    "deploy:verify": "node --experimental-strip-types scripts/verify-live-site.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "lucide-react": "^0.344.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}